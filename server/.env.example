PORT = 8080
FRONTEND_URL = http://localhost:5173
JWT_SECRET = jwt_secret_jakkash
SESSION_SECRET = session_secret_jakkash

# postgres db
DB_HOST='localhost'
DB_USER='postgres'
DB_PASSWORD='root'
DB_DATABASE='jakkash'
DB_PORT = 5432
DB_CONNECTION_LIMIT=10

# Used by dbmate only (the app itself reads the DB_* vars above — keep the two in sync).
# Hosted Postgres (Neon/Supabase): drop the sslmode=disable and use their connection string.
DATABASE_URL="postgres://postgres:root@localhost:5432/jakkash?sslmode=disable"

# Set to "production" to stop unexpected internal errors being echoed to clients
NODE_ENV=development

# Force TLS on/off for the database. Defaults to on for any non-local DB_HOST.
# DB_SSL=true

# ======================
# WhatsApp bill delivery
# ======================
# Required by the worker. Without these every delivery fails with a config error;
# the worker reports the missing names once at startup.
WHATSAPP_TOKEN="whatsapp_token_here"
# Meta WhatsApp Business phone number ID (legacy env name "id" is also supported)
WHATSAPP_PHONE_NUMBER_ID=1532583707888961
# Approved bill-delivery template with a document header and body params: customer name, bill number
WHATSAPP_TEMPLATE_NAME=jakkash_bill_delivery
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v21.0
# Prepended to 10-digit bill mobile numbers
WHATSAPP_DEFAULT_COUNTRY_CODE=91
# Per-request timeout for the Graph API, in ms (default: 30000). A hung request
# would otherwise hold a worker slot and strand the bill in processing.
# WHATSAPP_REQUEST_TIMEOUT_MS=30000

# Redis (BullMQ WhatsApp delivery queue). Needed by both the API and the worker.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_URL=redis://127.0.0.1:6379

# Separate worker process concurrency (default: 2)
WHATSAPP_DELIVERY_WORKER_CONCURRENCY=2